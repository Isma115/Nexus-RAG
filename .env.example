# Opcional: sin JWT_SECRET se genera uno temporal al arrancar (sesiones no persisten).
JWT_SECRET=cambia_este_secreto_por_uno_de_32_chars_minimo_123456
SESSION_DURATION=8h
NODE_ENV=development
PORT=3330

# RAG local: solo 'local' activo. 'rest'/'web'/'db' quedan registrados pero desactivados.
OFFLINE_ONLY=true
DEFAULT_SOURCE_TYPE=local

# Retrieval / generación extractiva local (sin LLM externo).
RAG_TOP_K=6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_MAX_DOC_BYTES=1500000

# Proveedor LLM futuro: 'extractive' (actual) | 'ollama' | 'openai'. Los dos últimos están preparados pero no activos.
LLM_PROVIDER=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gestión multi-usuario preparada a futuro. En 'false' solo existe modo offline mono-usuario.
USERS_ENABLED=false
